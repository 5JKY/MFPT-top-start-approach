/CharStrings 3 dict dup begin
/.notdef 0 def
/x 4 def
/tau 5 def
end readonly def

systemdict/resourcestatus known
 {42 /FontType resourcestatus
   {pop pop false}{true}ifelse}
 {true}ifelse
